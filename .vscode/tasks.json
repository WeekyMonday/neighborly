{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Neighborly backend",
            "type": "process",
            "command": "node",
            "args": ["BACKEND/server.js"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Neighborly backend listening on http://localhost:3001"
                }
            }
        }
    ]
}
